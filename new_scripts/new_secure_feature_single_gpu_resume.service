[Unit]
Description=New secure feature single-GPU formal experiment supervisor
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=-%h/.config/new-secure-feature-pipeline.env
Environment=NEW_SINGLE_GPU=0
Environment=NEW_CPU_CORE=0
Environment=LC_ALL=C
ExecStart=/bin/bash -lc 'exec "${NEW_PROJECT_ROOT}/new_scripts/new_single_gpu_supervisor.sh"'
Restart=always
RestartSec=30
KillMode=process

[Install]
WantedBy=default.target
