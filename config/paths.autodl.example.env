# AutoDL 数据盘示例。项目、MTT、数据和输出互相独立。
export PROJECT_ROOT=/root/autodl-tmp/mpl-optimization
export MTT_ROOT=/root/autodl-tmp/mtt-distillation
export DATA_ROOT=/root/autodl-tmp/mpl-data
export OFFICIAL_MTT_ROOT=/root/autodl-tmp/mpl-data/mtt_data/georgecazenavette
export OUTPUT_ROOT=/root/autodl-tmp/mpl-outputs

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export PYTHONNOUSERSITE=1

